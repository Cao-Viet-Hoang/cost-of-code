{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm run compile)",
      "Bash(npm run watch)",
      "Bash(npm run lint)",
      "Bash(npm run check)",
      "Bash(npm run package)",
      "Bash(npm run build-icon)",
      "Bash(npm test)",
      "Bash(npm run test)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx vsce:*)",
      "Bash(node --version)",
      "Bash(node scripts/build-icon.js)",
      "Bash(node scripts/import-projects-history.js:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(ls)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Edit(/.claude/skills/english-check/**)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(rm -rf:*)",
      "Bash(npm publish:*)"
    ]
  }
}
