{
  "name": "cost-of-code",
  "displayName": "Claude Code Usage Tracker",
  "publisher": "cost-of-code",
  "description": "Local-first dashboard for Claude Code token usage and estimated cost. Collects OpenTelemetry data locally and stores JSONL under ~/.claude/usage-tracker.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeUsageTracker.openDashboard",
        "title": "Claude Usage: Open Dashboard",
        "category": "Claude Usage"
      },
      {
        "command": "claudeUsageTracker.runSetup",
        "title": "Claude Usage: Run Setup (install collector + autostart)",
        "category": "Claude Usage"
      },
      {
        "command": "claudeUsageTracker.uninstall",
        "title": "Claude Usage: Uninstall Collector",
        "category": "Claude Usage"
      },
      {
        "command": "claudeUsageTracker.startCollector",
        "title": "Claude Usage: Start Collector",
        "category": "Claude Usage"
      },
      {
        "command": "claudeUsageTracker.stopCollector",
        "title": "Claude Usage: Stop Collector",
        "category": "Claude Usage"
      },
      {
        "command": "claudeUsageTracker.showStatus",
        "title": "Claude Usage: Show Collector Status",
        "category": "Claude Usage"
      }
    ],
    "configuration": {
      "title": "Claude Code Usage Tracker",
      "properties": {
        "claudeUsageTracker.dataFolder": {
          "type": "string",
          "default": "",
          "description": "Override the data folder. Empty means '~/.claude/usage-tracker'."
        },
        "claudeUsageTracker.collectorPort": {
          "type": "number",
          "default": 4318,
          "description": "Port the local OTLP/HTTP collector listens on."
        },
        "claudeUsageTracker.autoRefreshSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 0,
          "description": "Dashboard auto-refresh interval in seconds. 0 disables auto-refresh."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.118.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
