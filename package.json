{
  "name": "cost-of-code",
  "displayName": "Cost of Code",
  "publisher": "cost-of-code",
  "description": "Local-first dashboard for Claude Code token usage and estimated cost. Collects OpenTelemetry data locally and stores JSONL under ~/.claude/usage-tracker.",
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cao-Viet-Hoang/cost-of-code.git"
  },
  "bugs": {
    "url": "https://github.com/Cao-Viet-Hoang/cost-of-code/issues"
  },
  "homepage": "https://github.com/Cao-Viet-Hoang/cost-of-code#readme",
  "packageManager": "npm@11.9.0",
  "keywords": [
    "claude-code",
    "opentelemetry",
    "usage-tracker",
    "cost-dashboard",
    "vscode-extension"
  ],
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeUsageTracker.openDashboard",
        "title": "Open Dashboard",
        "category": "Cost of Code"
      },
      {
        "command": "claudeUsageTracker.runSetup",
        "title": "Run Setup (install collector + autostart)",
        "category": "Cost of Code"
      },
      {
        "command": "claudeUsageTracker.uninstall",
        "title": "Uninstall Collector",
        "category": "Cost of Code"
      },
      {
        "command": "claudeUsageTracker.startCollector",
        "title": "Start Collector",
        "category": "Cost of Code"
      },
      {
        "command": "claudeUsageTracker.stopCollector",
        "title": "Stop Collector",
        "category": "Cost of Code"
      },
      {
        "command": "claudeUsageTracker.showStatus",
        "title": "Show Collector Status",
        "category": "Cost of Code"
      },
      {
        "command": "claudeUsageTracker.importHistorical",
        "title": "Import Historical Usage (from ~/.claude/projects)",
        "category": "Cost of Code"
      }
    ],
    "configuration": {
      "title": "Cost of Code",
      "properties": {
        "claudeUsageTracker.dataFolder": {
          "type": "string",
          "default": "",
          "description": "Override the data folder. Empty means '~/.claude/usage-tracker'."
        },
        "claudeUsageTracker.collectorPort": {
          "type": "number",
          "default": 4318,
          "description": "Port the local OTLP/HTTP collector listens on."
        },
        "claudeUsageTracker.autoRefreshSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 0,
          "description": "Dashboard auto-refresh interval in seconds. 0 disables auto-refresh."
        },
        "claudeUsageTracker.pricing": {
          "type": "object",
          "default": {},
          "description": "Per-model pricing overrides for the cache-savings estimate. Keys are model-name substrings (e.g. \"sonnet\"); values are partial { input, output, cacheRead, cacheCreate } per 1M tokens.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "input": {
                "type": "number"
              },
              "output": {
                "type": "number"
              },
              "cacheRead": {
                "type": "number"
              },
              "cacheCreate": {
                "type": "number"
              }
            }
          }
        },
        "claudeUsageTracker.includeCodex": {
          "type": "boolean",
          "default": true,
          "description": "Include OpenAI Codex usage (read from ~/.codex/sessions JSONL rollouts) alongside Claude in the dashboard. Codex needs no collector — only file reads."
        },
        "claudeUsageTracker.codexSessionsFolder": {
          "type": "string",
          "default": "",
          "description": "Override the Codex sessions folder. Empty means '~/.codex/sessions'."
        },
        "claudeUsageTracker.codexPricing": {
          "type": "object",
          "default": {},
          "description": "Per-model pricing overrides for Codex cost estimates. Keys are model-name substrings (e.g. \"gpt-5\"); values are partial { input, cachedInput, output } per 1M tokens. Codex via Azure deployments may differ from OpenAI list prices.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "input": {
                "type": "number"
              },
              "cachedInput": {
                "type": "number"
              },
              "output": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "npm run compile && npm run lint",
    "build-icon": "node scripts/build-icon.js",
    "pretest": "npm run check",
    "lint": "eslint src --max-warnings=0",
    "package": "vsce package",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "3.9.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
